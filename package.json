{
    "name": "minidisc-workspace",
    "private": true,
    "version": "0.1.0",
    "license": "GPL-2.0",
    "packageManager": "npm@11.5.1",
    "engines": {
        "node": ">=20.19"
    },
    "type": "module",
    "scripts": {
        "start": "npm run dev",
        "dev": "npm run prepare-runtime && vite --configLoader runner",
        "build": "npm run prepare-runtime && npm run typecheck && vite build --configLoader runner",
        "typecheck": "tsc && tsc -p tsconfig.node.json --noEmit",
        "test": "tsx --test",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview --configLoader runner",
        "analyze": "source-map-explorer 'dist/assets/*.js'",
        "prepare-runtime": "node scripts/prepare-runtime.mjs",
        "runtime-assets:update": "npm run prepare-runtime && node scripts/generate-runtime-assets.mjs",
        "runtime-assets:check": "npm run prepare-runtime && node scripts/generate-runtime-assets.mjs --check",
        "runtime-assets:release-check": "npm run prepare-runtime && node scripts/generate-runtime-assets.mjs --check --release",
        "licenses:update": "node scripts/generate-third-party-notices.mjs",
        "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
        "audit:production": "npm audit --omit=dev",
        "pretty": "prettier src/**/*.{ts,tsx} --write",
        "mcp": "tsx bridge/mcp-stdio.ts",
        "cli": "tsx bridge/cli.ts",
        "desktop:prepare": "node desktop/build.mjs",
        "desktop:dev": "node node_modules/electron/install.js && npm run build && npm run desktop:prepare && electron .",
        "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --win nsis --x64",
        "desktop:typecheck": "tsc -p tsconfig.desktop.json"
    },
    "dependencies": {
        "@emotion/react": "^11.11.1",
        "@emotion/styled": "^11.11.0",
        "@ffmpeg/ffmpeg": "0.6.1",
        "@modelcontextprotocol/node": "^2.0.0",
        "@modelcontextprotocol/server": "2.0.0",
        "@mui/icons-material": "^5.14.3",
        "@mui/material": "^5.15.5",
        "async-mutex": "^0.5.0",
        "buffer": "^6.0.3",
        "clsx": "^2.1.0",
        "events": "^3.3.0",
        "himd-js": "^0.2.13",
        "jconv": "github:asivery/jconv-webminidisc",
        "music-metadata": "^11.10.3",
        "netmd-exploits": "^0.5.12",
        "netmd-js": "^4.4.1",
        "netmd-tocmanip": "^0.2.1",
        "networkwm-js": "^0.2.6",
        "prettier": "^3.2.5",
        "process": "^0.11.10",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-dropzone": "^14.2.3",
        "recorderjs": "github:asivery/Recorderjs",
        "stream-browserify": "^3.0.0",
        "util": "^0.12.5",
        "vite-plugin-svgr": "^4.3.0",
        "ws": "8.21.3",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/node": "^20.12.4",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@types/w3c-web-usb": "^1.0.4",
        "@types/ws": "8.18.1",
        "@typescript-eslint/eslint-plugin": "^7.5.0",
        "@typescript-eslint/parser": "^7.5.0",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^8.55.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "source-map-explorer": "^2.5.3",
        "tsx": "4.23.13",
        "typescript": "^5.9.3",
        "vite": "^6.3.5",
        "vite-plugin-pwa": "^0.21.1"
    },
    "description": "A local-first MiniDisc workspace with a modern UI and shared automation API",
    "overrides": {
        "expr-eval": "npm:expr-eval-fork@3.0.1"
    },
    "main": "desktop-build/main.cjs",
    "build": {
        "appId": "local.md-studio.desktop",
        "productName": "MD Studio",
        "directories": {
            "output": "release"
        },
        "files": [
            "desktop-build/**",
            "dist/**",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "vendor/zadig",
                "to": "zadig"
            },
            {
                "from": "skills",
                "to": "skills"
            },
            {
                "from": "desktop-build",
                "to": "cli",
                "filter": [
                    "cli.cjs",
                    "mdstudio.cmd"
                ]
            }
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
